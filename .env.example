# Copy to .env and fill in. Never commit .env.

# Supabase (Project Settings → API). Use the publishable (formerly "anon") key, never the secret/service_role key.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Public site URL, no trailing slash. Used for canonical/hreflang, sitemap, robots and OG.
# Read at BUILD time. Netlify: set it for the Production context (and, optionally, previews).
NUXT_PUBLIC_SITE_URL=https://chalkguide.example

# Indexing per environment (robots.txt, <meta robots>, X-Robots-Tag, sitemap). Nothing to set on
# Netlify: nuxt.config.ts reads Netlify's build variable CONTEXT, so only the `production` deploy
# with a real NUXT_PUBLIC_SITE_URL is indexable; deploy previews, branch deploys, local and any
# `*.example` domain are `noindex` (robots.txt `Disallow: /`, empty sitemap).
# Optional override for tests: NUXT_SITE_INDEXABLE=true | false

# --- Variables per environment (see docs/deploy-netlify.md) ---
# Local .env / Netlify (all contexts): NUXT_PUBLIC_SUPABASE_URL, NUXT_PUBLIC_SUPABASE_KEY, NUXT_PUBLIC_SITE_URL.
# Netlify only, until the domain (chalkguide.es, D67) is bought and pointed: NUXT_SITE_INDEXABLE=false (a *.netlify.app URL would
# otherwise count as a real domain and make the production deploy indexable).
# Netlify sets CONTEXT, NODE_VERSION is in netlify.toml: do not define them.
# Everything else (Claude API key, Brevo/Resend key, service_role) is a `supabase secret` for Edge
# Functions. NEVER put it here, in Netlify or behind a NUXT_PUBLIC_ prefix: no server route needs it today.
# Optional: NUXT_PUBLIC_REPO_URL=https://github.com/<org>/<repo> makes the Ingesta runbook a link (otherwise the path is shown as text).
