# Copy to .env and fill in. Never commit .env.

# Supabase (Project Settings → API). Use the publishable (formerly "anon") key, never the secret/service_role key.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Public site URL, no trailing slash. Used for canonical/hreflang, sitemap, robots and OG.
NUXT_PUBLIC_SITE_URL=https://chalkguide.example
